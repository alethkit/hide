name: hide-symbol-fixture
version: 0.1.0.0
synopsis: Fixture for the hide symbol-inspection acceptance run
license: BSD-2-Clause
build-type: Simple

-- One component on purpose: HLS resolves a definition in another module of the same
-- component immediately, but a definition in a separate library component only once that
-- component's modules have been loaded and indexed.
executable hide-symbol-fixture
  main-is: Main.hs
  other-modules: Shapes
  hs-source-dirs: app, src
  build-depends: base
  default-language: Haskell2010
