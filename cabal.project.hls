-- Project file used by Haskell Language Server (selected by hie.yaml).
-- It is the normal project with the optional frontends disabled, so that
-- `cabal repl` solves where pkg-config has no libghostty-vt (see docs/haskell.md).
import: cabal.project

package hide
  flags: -window -web -terminal
